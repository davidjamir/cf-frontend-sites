{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-frontend-sites",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
  ],
  "main": "vinext/server/fetch-handler",
  "workers_dev": false,
  "preview_urls": false,
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
    },
    "issues": {
      "enabled": true,
    },
  },
  "cache": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "services": [
    {
      "binding": "WORKER_R2_DATABASE",
      "service": "cf-storage-redirect",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
    },
  ],
  "vars": {
    "IS_CRYPTO_PAYLOAD": true,
  },
}
